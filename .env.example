# Скопируй этот файл в .env (только для запуска на своём компьютере).
# На Render эти значения вводятся в настройках сервиса, файл .env туда НЕ загружай.

# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token

# Твой числовой Telegram ID (узнать у бота @userinfobot)
OWNER_ID=123456789

# Часовой пояс и час контрольного ежедневного бэкапа (0-23)
TIMEZONE=Europe/Warsaw
BACKUP_HOUR=3

# Необязательно. Путь к базе (по умолчанию data/bot.db)
# DB_PATH=data/bot.db

# Необязательно. Публичный адрес сервиса. На Render он подставляется сам.
# Если задан, бот работает через webhook, если нет, через polling.
# WEBHOOK_BASE_URL=https://study-bot-xxxx.onrender.com
